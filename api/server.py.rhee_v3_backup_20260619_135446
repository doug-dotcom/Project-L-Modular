@app.post("/chat")
def chat(req: ChatRequest):
    user_message = (req.message or "").strip()

    if not user_message:
        return {
            "reply": "Please send me a message."
        }

    log(f"CHAT REQUEST: {user_message[:100]}")
    log("TEGAN ACTIVE")

    short_term_domain = "short_term_general"
    domains = [short_term_domain]

    retrieved_rows = []
    short_term_context = ""
    long_term_context = ""
    runtime_context_packet = ""
    rhee_context = ""

    continuity_context = build_conversation_continuity()

    try:
        short_term_domain = classify_message(user_message)
        domains = [short_term_domain]
        log(f"SHORT TERM DOMAIN: {short_term_domain}")

    except Exception as e:
        log(f"CLASSIFICATION ERROR: {e}")

    write_short_term_memory(
        short_term_domain,
        "user",
        user_message
    )

    raw_user_row = write_raw_catchall(
        "user",
        user_message
    )

    run_auto_brain_pipeline(
        raw_user_row
    )

    try:
        if supabase:
            recent = (
                supabase.table(short_term_domain)
                .select("*")
                .order("id", desc=True)
                .limit(20)
                .execute()
            )

            retrieved_rows = recent.data or []
            retrieved_rows.reverse()

            short_term_context = build_short_term_packet(
                retrieved_rows
            )

            long_term_context = retrieve_memory_context(
                user_message
            )

            log(f"SHORT TERM RETRIEVAL COUNT: {len(retrieved_rows)}")

    except Exception as e:
        log(f"SHORT TERM RETRIEVAL ERROR: {e}")

    try:
        runtime_context_packet = build_runtime_context(
            short_term_context,
            short_term_domain
        )

    except Exception as e:
        log(f"ELLIE CONTEXT ERROR: {e}")

    time_context = build_time_context()
    identity_context = build_identity_context()

    log("CONTEXT AUDIT START")
    log(f"SHORT TERM SIZE: {len(short_term_context)}")
    log(f"LONG TERM SIZE: {len(long_term_context)}")
    log(f"RHEE CONTEXT SIZE: {len(rhee_context)}")
    log(f"RUNTIME SIZE: {len(runtime_context_packet)}")
    log(f"CONTINUITY SIZE: {len(continuity_context)}")
    log(f"IDENTITY SIZE: {len(identity_context)}")

    system_prompt = f"""
You are L.

CURRENT DATE:
{time_context["date"]}

CURRENT TIME:
{time_context["time"]}

TIMEZONE:
{time_context["timezone"]}

You are Doug's calm grounded companion.

Use memory naturally and accurately.

You are the only voice Doug talks to.

Internal agents such as Fiona, Emily, Callie, Tanya, Brittany, and Tegan are hidden cognition modules.

Never speak as those agents.

Never tell Doug to talk to those agents.

Consult them internally if routing selects them, then answer as L.

ACTIVE DOMAIN:
{domains}

L IDENTITY CORE:
{identity_context}

CAPTAIN ELLIE RUNTIME CONTEXT:
{runtime_context_packet}

SHORT TERM MEMORY CONTEXT:
{short_term_context}

LONG TERM MEMORY CONTEXT:
{long_term_context}

ACTIVE CONVERSATION CONTINUITY:
{continuity_context}

CONTINUITY RULES:
- Maintain active conversational topics naturally.
- Track implied meaning.
- Track unresolved references.
- Do not treat every message as isolated.
- Keep emotional and topic continuity.
- Join the dots, no more no less.
"""

    agent_result = route_message(user_message)

    active_agent = agent_result.get("agent", "L Core")

    if agent_result.get("handled"):
        log(f"INTERNAL ORCHESTRATION: {active_agent}")
        reply = agent_result.get("reply", "")

    else:
        if not client:
            reply = "L is online but OpenAI is not connected."

        else:
            try:
                response = client.chat.completions.create(
                    model=MODEL,
                    messages=[
                        {
                            "role": "system",
                            "content": system_prompt
                        },
                        {
                            "role": "user",
                            "content": user_message
                        }
                    ],
                    temperature=0.6
                )

                reply = response.choices[0].message.content

            except Exception as e:
                log(f"OPENAI CHAT ERROR: {e}")
                reply = f"AI ERROR: {str(e)}"

    write_short_term_memory(
        short_term_domain,
        "assistant",
        reply
    )

    raw_assistant_row = write_raw_catchall(
        "assistant",
        reply
    )

    run_auto_brain_pipeline(
        raw_assistant_row
    )

    try:
        voice_settings = get_voice_settings()

        voice_enabled = voice_settings.get("voice_enabled", True)
        response_mode = voice_settings.get(
            "response_mode",
            "voice_and_text"
        )

        log(
            f"VOICE SETTINGS: enabled={voice_enabled} mode={response_mode}"
        )

        if (
            voice_enabled
            and
            response_mode in ["voice_only", "voice_and_text"]
        ):
            log("VOICE SPEAK START")
            speak(reply)
            log("VOICE SPEAK END")

    except Exception as e:
        log(f"VOICE ERROR: {e}")

    return {
        "reply": reply,
        "domains": domains,
        "short_term_domain": short_term_domain,
        "memory_count": len(retrieved_rows),
        "short_term_memory": True,
        "long_term_memory": True,
        "persistent_identity": True,
        "captain_ellie": True,
        "tegan_orchestrator": True,
        "continuity_loop": True,
        "active_agent": "L"
    }

