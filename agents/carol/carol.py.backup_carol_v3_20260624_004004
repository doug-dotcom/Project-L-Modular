import os
from datetime import datetime
from pathlib import Path

from dotenv import load_dotenv
from supabase import create_client

ROOT = Path(__file__).resolve().parents[2]
load_dotenv(ROOT / ".env")

SUPABASE_URL = os.getenv("SUPABASE_URL", "")
SUPABASE_KEY = (
    os.getenv("SUPABASE_SERVICE_ROLE_KEY", "")
    or os.getenv("SUPABASE_KEY", "")
)

supabase = create_client(
    SUPABASE_URL,
    SUPABASE_KEY
)

SOURCE_TABLE = "short_term_family"
TARGET_TABLE = "memory_family"

# =====================================================
# HELPERS
# =====================================================

def clean_content(text):
    return str(text or "").strip()

def classify_memory(content):

    text = clean_content(content).lower()

    # =================================================
    # NOISE DETECTION
    # =================================================

    noise_patterns = [
        "tell me about",
        "please recall",
        "recall ",
        "remember ",
        "what do you know about",
        "what can you tell me about",
        "who is ",
        "who are ",
        "ai error",
        "voice function called",
        "search query used",
        "here's what i currently remember",
        "here is what i currently remember",
    ]

    for pattern in noise_patterns:
        if pattern in text:
            return "NOISE"

    # =================================================
    # ACTIVE MEMORY
    # =================================================

    return "ACTIVE"

# =====================================================
# CAROL V2
# =====================================================

def run_carol_family(limit=10):

    result = (
        supabase.table(SOURCE_TABLE)
        .select("*")
        .order("id", desc=True)
        .limit(limit)
        .execute()
    )

    rows = result.data or []
    rows.reverse()

    moved = 0
    active_count = 0
    noise_count = 0

    for row in rows:

        content = clean_content(
            row.get("content", "")
        )

        if not content:
            continue

        memory_status = classify_memory(
            content
        )

        if memory_status == "ACTIVE":
            active_count += 1
        else:
            noise_count += 1

        payload = {
            "raw_id": row.get("id"),
            "content": content,
            "importance": 50,
            "salience": 50,
            "anchor": False,
            "memory_status": memory_status,
            "processed_by": ["carol_v2"],
            "metadata": {
                "source_table": SOURCE_TABLE,
                "carol_version": "2.0",
                "processed_at": datetime.now().isoformat()
            }
        }

        supabase.table(
            TARGET_TABLE
        ).insert(
            payload
        ).execute()

        moved += 1

    return {
        "status": "ok",
        "source": SOURCE_TABLE,
        "target": TARGET_TABLE,
        "moved": moved,
        "active": active_count,
        "noise": noise_count
    }

if __name__ == "__main__":
    print(run_carol_family())
